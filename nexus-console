#!/usr/bin/env python3
"""NEXUS-BTC Linux Command Line Console Executable.

Metasploit Framework & Zphisher styled command-line interface
for air-gapped Bitcoin transaction surveillance and digital forensics.
"""

import sys
import os
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
VENV_PYTHON = SCRIPT_DIR / ".venv" / "bin" / "python"

# Auto-switch to virtual environment Python interpreter if available
if VENV_PYTHON.exists() and sys.executable != str(VENV_PYTHON):
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON)] + sys.argv)

BACKEND_DIR = SCRIPT_DIR / "backend"

# Ensure repo root is priority in sys.path, followed by backend
if str(SCRIPT_DIR) in sys.path:
    sys.path.remove(str(SCRIPT_DIR))
sys.path.insert(0, str(SCRIPT_DIR))

if str(BACKEND_DIR) not in sys.path:
    sys.path.append(str(BACKEND_DIR))


# Launch console
if __name__ == "__main__":
    from nexus.console import main
    main()
